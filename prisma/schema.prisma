generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==============================
// ENUMS
// ==============================

enum UserRole {
  USER
  ADMIN
  WORKER
  CLIENT
}

enum WorkerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClientStatus {
  PENDING
  APPROVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}


model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String?   @unique
  email         String ?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?  @unique
  role          UserRole  @default(USER)
  password      String

  accounts Account[]
  sessions Session[]

  workerProfile WorkerProfile?
  clientProfile ClientProfile?

  sentMessages     Inbox[] @relation("SentMessages")
  receivedMessages Inbox[] @relation("ReceivedMessages")

  isVerified Boolean @default(false)
  token      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}




model WorkerProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  status         WorkerStatus @default(PENDING)
  trackingNumber String       @unique

  slug      String  @unique
  firstName String
  lastName  String
  gender    String?
  headline  String?
  bio       String?

  age Int      @default(0)
  specialties       String[] @default([])
  languages         String[] @default([])
  onboardingCompleted Boolean @default(false)

  profilePicture String?
  coverImage     String?
  gallery        String[] @default([])

  city    String
  country String @default("Zimbabwe")

  services WorkerService[]

  mobileService Boolean @default(false)
  studioService Boolean @default(true)

  availability Availability?
  bookings     Booking[]

  isFeatured  Boolean @default(false)
  isActive    Boolean @default(true)
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ClientProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  status ClientStatus @default(PENDING)

  trackingNumber String @unique

  phone String?
  city  String?
  bio   String?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// SERVICE CATALOGUE
// ==============================

model Service {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title       String
  slug        String  @unique
  description String?
  image       String?

  isActive Boolean @default(true)

  workers  WorkerService[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// WORKER SERVICES
// Connects workers to services
// ==============================

model WorkerService {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workerId  String @db.ObjectId
  serviceId String @db.ObjectId

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, serviceId])
}



model Speciality {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title    String
  slug     String  @unique
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Availability {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  workerProfileId String @unique @db.ObjectId

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  monday    String[] @default([])
  tuesday   String[] @default([])
  wednesday String[] @default([])
  thursday  String[] @default([])
  friday    String[] @default([])
  saturday  String[] @default([])
  sunday    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// INBOX / MESSAGES
// ==============================

model Inbox {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  recipientId String @db.ObjectId
  senderId    String @db.ObjectId

  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  senderName  String
  senderEmail String
  subject     String
  body        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// BOOKINGS
// Appointment management only
// ==============================

model Booking {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workerId String        @db.ObjectId
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)

  workerName String?

  clientId String        @db.ObjectId
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Restrict)

  firstName String?
  lastName  String?
  phone     String?
  gender    String?

  bookingDate DateTime?
  bookingTime String?

  serviceId String?  @db.ObjectId
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  serviceRequested  String?
  location          String?
  notes             String?
  appointmentReason String?
  totalHours        Int?

  status BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
  @@index([clientId])
  @@index([bookingDate])
  @@index([status])
}



// ==============================
// BLOG POSTS
// ==============================

model BlogPost {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title      String
  slug       String   @unique
  content    String?
  image      String
  categories String[]

  lastUpdated String

  publishedAt DateTime?
  isPublished Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// AUTHENTICATION
// ==============================

model Account {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId

  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.String
  access_token  String? @db.String
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.String
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
